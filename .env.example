# Copy to .env.local for local development against Supabase,
# or set these in Vercel → Settings → Environment Variables.
# NEVER put real credentials in this file or any file committed to git.

# Supabase Postgres connection string (Project Settings → Database →
# Connection pooling → URI; replace [YOUR-PASSWORD])
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres

# Any long random string (openssl rand -hex 32)
AUTH_SECRET=<random-64-hex>

# The code required to sign up as an administrator (keep it long and random)
ADMIN_ACCESS_CODE=<your-admin-code>
