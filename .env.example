# Copy to .env.local for local development against Supabase,
# or set these in Vercel → Settings → Environment Variables.
# NEVER commit real credentials to this file or any file tracked in git.

# ── 1. Database (Supabase PostgreSQL) ─────────────────────────────────────────
# URI from Supabase Project Settings → Database → Connection pooling (Transaction mode)
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── 2. Server Authentication ──────────────────────────────────────────────────
# 64-char random hex string (generate with: openssl rand -hex 32)
AUTH_SECRET=<random-64-hex>

# Secret access code required to register as an administrator
ADMIN_ACCESS_CODE=<your-admin-code>

# ── 3. Payment Gateway (Razorpay) ─────────────────────────────────────────────
# Key ID & Key Secret from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_<your-key-id>
RAZORPAY_KEY_SECRET=<your-key-secret>
# Webhook secret from Razorpay Dashboard → Settings → Webhooks
RAZORPAY_WEBHOOK_SECRET=<your-webhook-secret>

# Payment policy: "required" | "optional" | "off"
CLINIC_PAYMENT_POLICY=required
# Consultation fee per appointment in INR
APPOINTMENT_FEE_INR=500

# ── 4. Ayushman Bharat Digital Mission (ABDM Sandbox) ─────────────────────────
# Client credentials from https://sandbox.abdm.gov.in/
ABDM_CLIENT_ID=SBX_<your-client-id>
ABDM_CLIENT_SECRET=<your-client-secret>
ABDM_SANDBOX_URL=https://dev.abdm.gov.in/gateway
